{
  "version": "0.2.0",
  "extensionAuth": {
    "authorizePath": "/v1/auth/oauth2/authorize",
    "tokenPath": "/v1/auth/oauth2/token",
    "revokePath": "/v1/auth/oauth2/revoke",
    "clientId": "zoho-crm-devtools-extension",
    "signupHint": {
      "parameter": "screen_hint",
      "value": "signup"
    },
    "scopes": ["entitlement:read", "offline_access"],
    "redirectPattern": "chrome-extension://<extension-id>/src/billing/oauth-callback.html",
    "accessTokenLifetimeSeconds": 900,
    "refreshTokenLifetimeSeconds": 2592000
  },
  "legalDocuments": {
    "terms": {
      "effectiveAt": "2026-10-20"
    },
    "privacy": {
      "effectiveAt": "2026-10-20"
    }
  },
  "plans": [
    {
      "key": "free",
      "name": "Free",
      "priceUsdMonthly": 0,
      "features": []
    },
    {
      "key": "plus",
      "name": "Plus",
      "priceUsdMonthly": 23,
      "introPriceUsdFirstMonth": 9,
      "features": ["exportFunctions", "workflowSearch"]
    },
    {
      "key": "pro",
      "name": "Pro",
      "priceUsdMonthly": 57,
      "introPriceUsdFirstMonth": 35,
      "features": ["exportFunctions", "workflowSearch", "automationMap"]
    },
    {
      "key": "max",
      "name": "Max",
      "priceUsdMonthly": 143,
      "introPriceUsdFirstMonth": 99,
      "features": ["exportFunctions", "workflowSearch", "automationMap"]
    }
  ],
  "introOffer": {
    "months": 1
  },
  "trial": {
    "plan": "plus",
    "days": 14
  }
}
